{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/session-start.mjs\"", "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/auto-recall.mjs\"", "timeout": 30 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/auto-capture.mjs\"", "timeout": 45 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/pre-compact.mjs\"", "timeout": 30 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${DROID_PLUGIN_ROOT}/scripts/session-end.mjs\"", "timeout": 30 }] }
    ]
  }
}
